{
  "$schema": "https://unpkg.com/knip@5/schema.jsonc",
  // The route files are only imported by src/routeTree.gen.ts, which is
  // generated by the TanStack Router vite plugin and gitignored. It does not
  // exist on a clean checkout (e.g. in CI before a build), so treat the route
  // files as entry points to keep knip deterministic without a build step.
  "entry": ["src/main.tsx", "src/routes/**/*.tsx"],
  // src/routeTree.gen.ts is generated and gitignored, so the import of it in
  // src/router.tsx is unresolved on a clean checkout; that is expected.
  "ignoreUnresolved": ["@/routeTree.gen"],
  // Mobile plugin packages are the JavaScript API layer for the Rust plugins
  // registered in src-tauri/src/lib.rs. They are wired in and ready for adopters
  // to import, so they are intentionally present even though the template body
  // does not call them yet.
  "ignoreDependencies": [
    "@tauri-apps/plugin-deep-link",
    "@tauri-apps/plugin-geolocation",
    "@tauri-apps/plugin-notification",
    "@tauri-apps/plugin-opener"
  ]
}
